# Shared password typed at /login. Keep this off git.
SITE_PASSWORD=change-me

# Long random string used only to sign the session cookie.
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string

# Anthropic key used to review uploaded COI PDFs.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Defaults to claude-opus-5.
# ANTHROPIC_MODEL=claude-opus-5
